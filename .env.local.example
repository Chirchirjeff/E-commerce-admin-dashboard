# ============================================================
# Quza Admin Dashboard — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
#
#   cp .env.local.example .env.local
#
# NEVER commit .env.local to version control.
# ============================================================


# ------------------------------------------------------------
# Backend API
# ------------------------------------------------------------
# Base URL of your Quza backend service (no trailing slash).
# Used by both the API client (axios) and server-side helpers.
NEXT_PUBLIC_API_URL=http://localhost:4000


# ------------------------------------------------------------
# Transactional Email
# ------------------------------------------------------------
# All mail is dispatched through the backend's Gmail SMTP configuration.
# This dashboard needs no mail provider credentials. Keep its API URL pointed
# at the backend that contains SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS,
# and SMTP_FROM.
SUPPORT_EMAIL=support.fontspree@gmail.com


# ------------------------------------------------------------
# Quza Brand URLs  (used inside email templates)
# ------------------------------------------------------------
# Public URL of your storefront — appears in email CTAs & footer links.
NEXT_PUBLIC_STOREFRONT_URL=https://quza.app

# Public URL of this admin dashboard — used in admin welcome emails.
NEXT_PUBLIC_APP_URL=https://admin.quza.app

# Optional: hosted URL of your Quza logo image (PNG/SVG, ~120×40px).
# If left blank, the text "Quza" renders as the logo.
NEXT_PUBLIC_LOGO_URL=
